{
  "version": 2,
  "daemons": {
    "bullmq-worker": {
      "root": ".",
      "entrypoint": "worker/Dockerfile",
      "command": ["node", "dist-api/queues/mailWorker.mjs"],
      "instances": {
        "sin1": 1
      }
    }
  },
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
