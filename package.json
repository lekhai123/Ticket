{
  "name": "task-thuc-tap-backend",
  "version": "1.0.0",
  "description": "Backend API Server",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx api/index.ts",
    "build:be": "tsup api/index.ts --out-dir api --format esm --no-splitting",
    "vercel-build": "prisma generate && npm run build:be && cd frontend && npm install && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.12.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.19.3",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.2",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.21",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.5.2",
    "multer": "^2.2.0",
    "node-cache": "^5.1.2",
    "node-cron": "^4.6.0",
    "prisma": "^6.19.3",
    "resend": "^6.18.1",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/node-cron": "^3.0.11",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
