# ==========================================
# 1. DATABASE (PostgreSQL qua Docker)
# ==========================================
# Kết nối qua PgBouncer (Port 6432) cho ứng dụng chính
DATABASE_URL="postgresql://postgres:password123@localhost:6432/nexusticket?pgbouncer=true"

# Kết nối trực tiếp (Port 5432) cho lệnh 'npx prisma migrate dev'
DIRECT_URL="postgresql://postgres:password123@localhost:5432/nexusticket"


# ==========================================
# 2. REDIS (Distributed Lock, Cache & Queue)
# ==========================================
# Redis Local chạy trong Docker
REDIS_URL="redis://localhost:6379"

# Redis Backup (có thể trỏ lại Redis Local hoặc URL dự phòng)
REDIS_URL_BACKUP="redis://localhost:6379"


# ==========================================
# 3. AI SERVICES (Gemini API & Local DQN)
# ==========================================
# Khóa Gemini chính và phụ (cho cơ chế retry fallback)
GEMINI_API_KEY="dien_gemini_api_key_tai_day"
GEMINI_SECONDARY_KEY="dien_gemini_secondary_key_tai_day"

# Endpoint của AI Dynamic Pricing Service (Python FastAPI trong Docker)
AI_SERVICE_URL="http://localhost:8000"


# ==========================================
# 4. JWT & AUTHENTICATION
# ==========================================
JWT_SECRET="nexusticket_secret_key_local_dev"
JWT_ACCESS_SECRET="nexusticket_access_secret_local_dev"
JWT_REFRESH_SECRET="nexusticket_refresh_secret_local_dev"


# ==========================================
# 5. CLOUDINARY (Upload hình ảnh sự kiện / vé)
# ==========================================
CLOUDINARY_CLOUD_NAME="ddikqghnm"
CLOUDINARY_API_KEY="dien_cloudinary_key"
CLOUDINARY_API_SECRET="dien_cloudinary_secret"

CLOUDINARY_CLOUD_NAME_BACKUP="dien_backup_name"
CLOUDINARY_API_KEY_BACKUP="dien_backup_key"
CLOUDINARY_API_SECRET_BACKUP="dien_backup_secret"


# ==========================================
# 6. MAIL & URLS
# ==========================================
RESEND_API_KEY="dien_resend_api_key_tai_day"

# Local URL cho Frontend và API Vite
VITE_API_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
PORT=3000