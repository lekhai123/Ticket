generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  
  // Cho phép null vì user có thể chỉ đăng nhập bằng Passkeys
  password  String?   
  
  fullName  String
  role      Role      @default(CUSTOMER)
  createdAt DateTime  @default(now())
  avatarUrl String?   @db.Text
  payments  PaymentTransaction[]
  
  // THÊM MỚI: Dành cho bảo mật & Passkeys
  phoneNumber      String?   @db.Text // Sẽ được mã hóa AES-256-GCM (ALE)
  currentChallenge String?   // Lưu thử thách (challenge) tạm thời của WebAuthn
  auditLogs     AuditLog[] 
  
  tickets     Tickets[]
  wallet      Wallets?
  credentials WebAuthnCredential[] // Liên kết với bảng Passkeys

  @@index([email])
}

// THÊM MỚI: Bảng lưu trữ Passkey (WebAuthn)
model WebAuthnCredential {
  id           String   @id @default(uuid())
  userId       Int
  credentialID String   @unique @db.Text // ID của Passkey (Base64URL)
  publicKey    String   @db.Text         // Khóa công khai (Base64URL)
  counter      Int      @default(0)      // Chống Replay Attack
  transports   String?                   // "usb", "nfc", "ble", "internal"
  createdAt    DateTime @default(now())

  user         Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Wallets {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  balance   Decimal  @default(0.00) @db.Decimal(12, 2)
  isLocked  Boolean  @default(false)
  updatedAt DateTime @updatedAt
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Trips {
  id          Int                    @id @default(autoincrement())
  route       String
  departureAt DateTime
  price       Decimal                @db.Decimal(10, 2)
  totalSeats  Int                    @default(30)
  createdAt   DateTime               @default(now())
  embedding   Unsupported("vector(1536)")?
  description String?
  tickets     Tickets[]

  @@index([route, departureAt])
}

model Tickets {
  id            Int          @id @default(autoincrement())
  userId        Int
  tripId        Int
  seatNumber    Int
  batchId       String?
  status        TicketStatus @default(PENDING)
  createdAt     DateTime     @default(now())

  paymentMethod String?      // "WALLET" | "LATER" | "GIFT" | "ADMIN_GRANT" | "LEGACY"
  paidAmount    Decimal?     @db.Decimal(12, 2)

  trip          Trips        @relation(fields: [tripId], references: [id])
  user          Users        @relation(fields: [userId], references: [id])

  @@index([tripId, seatNumber])
  @@index([userId, status])
}

enum OtpType {
  REGISTER
  FORGOT_PASSWORD
}

model OTP {
  id        Int      @id @default(autoincrement())
  email     String
  code      String   @db.VarChar(6)
  type      OtpType  @default(REGISTER)
  attempts  Int      @default(0)        
  expiredAt DateTime
  createAt  DateTime @default(now())

  @@index([email, code])
  @@index([email, type])
}

enum Role {
  ADMIN
  CUSTOMER
}

enum TicketStatus {
  HELD
  PENDING
  EXPIRED
  CONFIRMED
  USED
  CANCELED
  REVOKED_BY_ADMIN
}

model AuditLog {
  id            String   @id @default(uuid())
  requestId     String
  userId        Int?
  action        String
  batchId       String?
  resource      String
  resourceId    String
  oldData       Json?
  newData       Json?
  isRevoked     Boolean  @default(false)
  ipAddress     String?
  signature     String?
  createdAt     DateTime @default(now())
  user          Users?   @relation(fields: [userId], references: [id])

  @@index([requestId])
  @@index([userId])
  @@index([batchId])
}

model BlacklistedIPs {
  id         Int      @id @default(autoincrement())
  ipAddress  String   @unique
  userId     Int?
  reason     String
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
model PaymentTransaction {
  id            String   @id @default(uuid())
  orderCode     Int      @unique // Mã đơn hàng gửi sang PayOS
  userId        Int
  amount        Decimal  @db.Decimal(12, 2)
  status        String   @default("PENDING") // PENDING, SUCCESS, FAILED, EXPIRED
  provider      String   @default("PAYOS")
  checkoutUrl   String?
  paymentLinkId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          Users    @relation(fields: [userId], references: [id])

  @@index([userId, status])
}