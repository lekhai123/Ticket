generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  fullName  String
  role      Role      @default(CUSTOMER)
  createdAt DateTime  @default(now())
avatarUrl String?  @db.Text  
tickets   Tickets[]
  wallet    Wallets?
}

model Wallets {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  balance   Decimal  @default(0.00) @db.Decimal(12, 2)
  isLocked  Boolean  @default(false)
  updatedAt DateTime @updatedAt
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Trips {
  id          Int                    @id @default(autoincrement())
  route       String
  departureAt DateTime
  price       Decimal                @db.Decimal(10, 2)
  totalSeats  Int                    @default(30)
  createdAt   DateTime               @default(now())
  embedding   Unsupported("vector(1536)")?
  description String?
  tickets     Tickets[]

  @@index([route, departureAt])
}

model Tickets {
  id         Int          @id @default(autoincrement())
  userId     Int
  tripId     Int
  seatNumber Int
  status     TicketStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  trip       Trips        @relation(fields: [tripId], references: [id])
  user       Users        @relation(fields: [userId], references: [id])

  @@unique([tripId, seatNumber])
  @@index([userId])
}

enum OtpType {
  REGISTER
  FORGOT_PASSWORD
}

model OTP {
  id        Int      @id @default(autoincrement())
  email     String
  code      String   @db.VarChar(6)
  type      OtpType  @default(REGISTER) 
  attempts  Int      @default(0)        
  expiredAt DateTime
  createAt  DateTime @default(now())

  @@index([email, code])
  @@index([email, type])
}

enum Role {
  ADMIN
  CUSTOMER
}

enum TicketStatus {
  HELD            
  PENDING           
  EXPIRED           
  CONFIRMED         
  USED              
  CANCELED          
  REVOKED_BY_ADMIN  
  CANCELLED
}
model AuditLog {
  id            String   @id @default(uuid())
  requestId     String   
  userId        Int?
  action        String   
  batchId       String?  
  resource      String  
  resourceId    String  
  oldData       Json?    
  newData       Json?   
  isRevoked     Boolean  @default(false) 
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([requestId])
  @@index([userId])
  @@index([batchId])
  
}

model BlacklistedIPs {
  id         Int      @id @default(autoincrement())
  ipAddress  String   @unique
  userId     Int?
  reason     String
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
